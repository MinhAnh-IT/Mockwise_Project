# ================================================================
#  Mockwise — Environment Variables
#  Copy to .env and fill in secrets before deploying:
#    cp .env.example .env
# ================================================================

# ─── App ────────────────────────────────────────────────────────
NODE_ENV=production
IMAGE_TAG=latest

# ─── MySQL ──────────────────────────────────────────────────────
MYSQL_HOST=your-vps-ip
MYSQL_PORT=3306
MYSQL_USER=mockwise
MYSQL_PASSWORD=changeme

# ─── Redis ──────────────────────────────────────────────────────
REDIS_HOST=your-vps-ip
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# ─── Kafka ──────────────────────────────────────────────────────
SPRING_KAFKA_BOOTSTRAP_SERVERS=your-vps-ip:9092

# ─── Auth ───────────────────────────────────────────────────────
JWT_COOKIE_SECURE=true              # false for local dev
JWT_HMAC_SECRET=changeme-min-32-chars-secret-key

# ─── CORS ───────────────────────────────────────────────────────
CORS_ORIGIN=http://your-vps-ip      # or your domain

# ─── Mail (SMTP) ────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password     # Gmail App Password

# ─── AI Evaluation ──────────────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key
MODEL_NAME=gemini-flash-latest
MAX_RETRIES=2
MODEL_VERSION=evaluator-v1.0
# Shared secret clients must send in the X-API-Key header on /api/ai/**
# Generate a value with: openssl rand -hex 32
AI_SERVICE_API_KEY=BB3920D5FC08D243384BCBCFA44C9712

# ─── Judge0 (code execution engine) ────────────────────────────
# Prerequisite: create shared network once on the server
#   docker network create mockwise-judge-net
#
# Option A — Judge0 on same server, joined to mockwise-judge-net (recommended):
JUDGE0_BASE_URL=http://judge0-server:2358
JUDGE_CALLBACK_BASE_URL=http://judge-service:8083
#
# Option B — Judge0 on a different host:
# JUDGE0_BASE_URL=http://your-judge0-host:2358
# JUDGE_CALLBACK_BASE_URL=http://your-vps-ip   # routes via nginx
#
JUDGE0_AUTH_TOKEN=your-judge0-auth-token

# ─── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_HOST=your-vps-ip
POSTGRES_PORT=5432
POSTGRES_USER=mockwise
POSTGRES_PASSWORD=changeme

# ─── MinIO ──────────────────────────────────────────────────────
# Endpoint used by services inside the cluster (server-to-server calls).
MINIO_ENDPOINT=http://your-vps-ip:9000
# Endpoint embedded in presigned URLs that browsers resolve. Often the same
# as MINIO_ENDPOINT, but switch to a public hostname (e.g. https://cdn.example.com)
# when MinIO is fronted by nginx/Cloudflare.
MINIO_PUBLIC_ENDPOINT=http://your-vps-ip:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
# Service account used by storage-service. Create with `mc admin user add` and
# grant a policy scoped to interview-videos + question-audio buckets only —
# do NOT use the root credentials in production.
MINIO_ACCESS_KEY=storage-svc
MINIO_SECRET_KEY=changeme

# ─── Internal service-to-service auth ───────────────────────────
# Shared secret sent as X-Internal-Auth on /internal/** endpoints
# (e.g. interview-service → storage-service for presigned download URLs).
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=changeme-internal-shared-secret
