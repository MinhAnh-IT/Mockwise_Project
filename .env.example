# ─── App ───────────────────────────────────────────────────────
NODE_ENV=development

# ─── MySQL (VPS :3306) — databases: iam, user_profile, billing, question_bank
MYSQL_HOST=your-vps-ip
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_USER=mockwise
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=mockwise

# ─── PostgreSQL (VPS :5432) — database: interview_session ──────
POSTGRES_HOST=your-vps-ip
POSTGRES_PORT=5432
POSTGRES_DB=interview_session
POSTGRES_USER=mockwise
POSTGRES_PASSWORD=changeme

# ─── Redis (VPS :6379) ─────────────────────────────────────────
REDIS_HOST=your-vps-ip
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# ─── Kafka (VPS :9092) ─────────────────────────────────────────
KAFKA_EXTERNAL_HOST=your-vps-ip
SPRING_KAFKA_BOOTSTRAP_SERVERS=your-vps-ip:9092

# ─── MinIO (VPS :9000) ─────────────────────────────────────────
MINIO_ENDPOINT=http://your-vps-ip:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme

# ─── Auth (Spring IAM Service) ─────────────────────────────────
JWT_COOKIE_SECURE=false

# ─── API Gateway ───────────────────────────────────────────────
IAM_SERVICE_URL=http://iam-service:8081
USER_PROFILE_SERVICE_URL=http://user-profile-service:8082
CORS_ORIGIN=*

# ─── Mail (SMTP) ───────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ─── AI Evaluation ─────────────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key
MODEL_NAME=gemini-flash-latest
MAX_RETRIES=2
MODEL_VERSION=evaluator-v1.0

# ─── Frontend ──────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost/api

# ─── Docker Registry (CD) ──────────────────────────────────────
REGISTRY=ghcr.io
IMAGE_PREFIX=your-org/mockwise
IMAGE_TAG=latest
