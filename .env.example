# ================================================================
#  Mockwise — Environment Variables
#  Copy to .env and fill in secrets before deploying:
#    cp .env.example .env
# ================================================================

# ─── App ────────────────────────────────────────────────────────
NODE_ENV=production
IMAGE_TAG=latest

# ─── MySQL ──────────────────────────────────────────────────────
MYSQL_HOST=your-vps-ip
MYSQL_PORT=3306
MYSQL_USER=mockwise
MYSQL_PASSWORD=changeme

# ─── Redis ──────────────────────────────────────────────────────
REDIS_HOST=your-vps-ip
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# ─── Kafka ──────────────────────────────────────────────────────
SPRING_KAFKA_BOOTSTRAP_SERVERS=your-vps-ip:9092

# ─── Auth ───────────────────────────────────────────────────────
JWT_COOKIE_SECURE=true              # false for local dev
JWT_HMAC_SECRET=changeme-min-32-chars-secret-key

# ─── CORS ───────────────────────────────────────────────────────
CORS_ORIGIN=http://your-vps-ip      # or your domain

# ─── Mail (SMTP) ────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password     # Gmail App Password

# ─── AI Evaluation ──────────────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key
MODEL_NAME=gemini-flash-latest
MAX_RETRIES=2
EVALUATOR_VERSION=evaluator-v1.0
# Backwards-compat alias — older code still reads MODEL_VERSION.
MODEL_VERSION=evaluator-v1.0
# Shared secret clients must send in the X-API-Key header on /api/ai/**
# Generate a value with: openssl rand -hex 32
AI_SERVICE_API_KEY=BB3920D5FC08D243384BCBCFA44C9712

# ─── AI Service · Question Selector (RAG) ──────────────────────
# Embeddings via Gemini. gemini-embedding-001 supports configurable
# output dim (default 3072) — we pin to 768 to match pgvector(768).
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
SELECTOR_VERSION=selector-v1.0
# Kafka stream that question-bank-service publishes to. The AI service
# consumes it to keep its pgvector index in sync. Topic auto-creates.
KAFKA_TOPIC_QUESTION_BANK=question-bank-events
KAFKA_CONSUMER_GROUP_SELECTOR=ai-service-selector
# Selector reads its index from a separate Postgres database. Create it
# once with `CREATE DATABASE ai_question_selector;` and run
# AI/selector/migrations/V1__init_schema.sql which installs pgvector.
# When DATABASE_URL is unreachable, /selector/* endpoints return 503
# but /evaluate and /generate-testcases keep working.
# Note: the Postgres image MUST include pgvector — switch to
# `pgvector/pgvector:pg16` (drop-in for postgres:16) before running migrations.

# ─── Judge0 (code execution engine) ────────────────────────────
# Prerequisite: create shared network once on the server
#   docker network create mockwise-judge-net
#
# Option A — Judge0 on same server, joined to mockwise-judge-net (recommended):
JUDGE0_BASE_URL=http://judge0-server:2358
JUDGE_CALLBACK_BASE_URL=http://judge-service:8083
#
# Option B — Judge0 on a different host:
# JUDGE0_BASE_URL=http://your-judge0-host:2358
# JUDGE_CALLBACK_BASE_URL=http://your-vps-ip   # routes via nginx
#
JUDGE0_AUTH_TOKEN=your-judge0-auth-token

# ─── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_HOST=your-vps-ip
POSTGRES_PORT=5432
POSTGRES_USER=mockwise
POSTGRES_PASSWORD=changeme

# ─── MinIO ──────────────────────────────────────────────────────
# Endpoint used by services inside the cluster (server-to-server calls).
MINIO_ENDPOINT=http://your-vps-ip:9000
# Endpoint embedded in presigned URLs that browsers resolve. Often the same
# as MINIO_ENDPOINT, but switch to a public hostname (e.g. https://cdn.example.com)
# when MinIO is fronted by nginx/Cloudflare.
MINIO_PUBLIC_ENDPOINT=http://your-vps-ip:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
# Service account used by storage-service. Create with `mc admin user add` and
# grant a policy scoped to interview-videos + question-audio buckets only —
# do NOT use the root credentials in production.
MINIO_ACCESS_KEY=storage-svc
MINIO_SECRET_KEY=changeme

# ─── Internal service-to-service auth ───────────────────────────
# Shared secret sent as X-Internal-Auth on /internal/** endpoints
# (e.g. interview-service → storage-service for presigned download URLs).
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=changeme-internal-shared-secret

# ─── TTS-STT (ElevenLabs) ───────────────────────────────────────
# API key from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# Default voice (Rachel) — override per-question via API
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TIMEOUT_TTS_MS=30000
ELEVENLABS_TIMEOUT_STT_MS=600000
# Kafka topics — defaults match interview-service producer side
KAFKA_TOPIC_ANSWER_SUBMITTED=answer-submitted
KAFKA_TOPIC_TRANSCRIPT_READY=transcript-ready
KAFKA_TOPIC_TRANSCRIPT_FAILED=transcript-failed
