# Backend gateway URL — used by Vite dev proxy and nginx (production) to forward /api/*
VITE_API_PROXY_TARGET=http://31.220.84.140

# Optional: only set this if you want frontend to call backend directly (CORS must be enabled).
# Leave empty to use the dev/nginx proxy (recommended).
# VITE_API_BASE_URL=

# Social login (OAuth) — public client IDs only (the secrets live in iam-service).
# Leave empty to hide a provider's button. Authorized redirect URI for both must
# be <frontend-origin>/auth/callback (e.g. http://localhost:3000/auth/callback).
# VITE_GOOGLE_CLIENT_ID=
# VITE_GITHUB_CLIENT_ID=
